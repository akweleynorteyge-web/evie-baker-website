<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Evie Baker offers custom cakes, premium finishes and delicious flavours made to order in Ghana."
    />
    <title>Evie Baker | Cakes made for your moments</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="style.css" />
  </head>
  <body>
    <header class="site-header">
      <div class="container nav-wrap">
        <a class="brand" href="#top" aria-label="Evie Baker home">EVIE BAKER</a>
        <nav class="main-nav" aria-label="Main navigation">
          <a href="#cake-menu">Cakes</a>
          <a href="#add-ons">Add-ons</a>
          <a href="#order">Order</a>
          <a href="#contact">Contact</a>
        </nav>
      </div>
    </header>

    <main id="top">
      <section class="hero section-shell">
        <div class="container hero-grid">
          <div class="hero-copy">
            <p class="eyebrow">Cakes made for your moments</p>
            <h1>EVIE BAKER</h1>
            <p class="tagline">Cakes made for your moments.</p>
            <p class="intro">
              Custom cakes, beautiful finishes and delicious flavours, made to order in Ghana.
            </p>
            <div class="hero-actions">
              <a href="#cake-menu" class="btn btn-primary">VIEW CAKES</a>
              <a href="#order" class="btn btn-secondary" data-whatsapp="true">ORDER ON WHATSAPP</a>
            </div>
          </div>

          <div class="hero-visual">
            <img
              src="https://images.unsplash.com/photo-1558301211-0d8c8ddee6ec?auto=format&fit=crop&w=900&q=80"
              alt="Elegant cake with soft pink frosting and floral accents"
            />
          </div>
        </div>
      </section>

      <section id="cake-menu" class="section-shell menu-section">
        <div class="container">
          <div class="section-heading">
            <p class="eyebrow">Cake menu</p>
            <h2>Something sweet for every celebration.</h2>
          </div>

          <div class="menu-grid">
            <article class="pricing-card large-card">
              <h3>STANDARD CAKES</h3>
              <div class="category-block">
                <h4>Medium — 2 Layers</h4>
                <ul>
                  <li><span>6 inch</span><strong>GHS 550</strong></li>
                  <li><span>7 inch</span><strong>GHS 600</strong></li>
                  <li><span>8 inch</span><strong>GHS 700</strong></li>
                </ul>
              </div>

              <div class="category-block">
                <h4>Large — 3 Layers</h4>
                <ul>
                  <li><span>6 inch</span><strong>GHS 770</strong></li>
                  <li><span>7 inch</span><strong>GHS 920</strong></li>
                  <li><span>8 inch</span><strong>GHS 1,150</strong></li>
                </ul>
              </div>
            </article>

            <article class="pricing-card large-card">
              <h3>CHARACTER CAKES</h3>
              <p class="card-copy">
                Custom character cakes are priced according to the finish and complexity of the design.
              </p>
              <p class="card-copy muted">
                These prices cover standard paper-cut character designs.
              </p>

              <div class="category-block">
                <h4>Medium</h4>
                <ul>
                  <li><span>6 inch</span><strong>from GHS 650</strong></li>
                  <li><span>7 inch</span><strong>GHS 750</strong></li>
                  <li><span>8 inch</span><strong>GHS 850</strong></li>
                </ul>
              </div>

              <div class="category-block">
                <h4>Large — 3 Layers</h4>
                <ul>
                  <li><span>6 inch</span><strong>GHS 900</strong></li>
                  <li><span>7 inch</span><strong>GHS 1,070</strong></li>
                  <li><span>8 inch</span><strong>GHS 1,300</strong></li>
                </ul>
              </div>

              <p class="note">
                Special name toppers, moulds, 3D characters and more elaborate designs are priced separately.
              </p>
            </article>

            <article class="pricing-card">
              <h3>DELUXE CAKES</h3>
              <p class="card-copy">
                Our Deluxe cakes are made with selected deluxe flavours and premium fillings.
              </p>
            </article>

            <article class="pricing-card">
              <h3>TALL CAKES</h3>
              <p class="card-copy">
                9" and 10" cakes, usually made with 4 layers.
              </p>
              <p class="card-copy strong-copy">Priced according to flavour, filling and design.</p>
            </article>

            <article class="pricing-card">
              <h3>TIERED CAKES</h3>
              <p class="card-copy">
                Our tiered cakes are completely customised.
              </p>
              <p class="card-copy strong-copy">Pricing available after consultation.</p>
            </article>

            <article class="pricing-card">
              <h3>SPECIAL CAKE SIZES &amp; SHAPES</h3>
              <ul class="list-col">
                <li>Sheet cakes</li>
                <li>Oval cakes</li>
                <li>Rectangular cakes</li>
                <li>Square cakes</li>
                <li>Heart-shaped cakes</li>
                <li>Other custom shapes</li>
              </ul>
              <p class="card-copy strong-copy">Pricing available after consultation.</p>
            </article>
          </div>
        </div>
      </section>

      <section id="add-ons" class="section-shell add-ons-section">
        <div class="container add-ons-wrap">
          <div class="section-heading left-aligned">
            <p class="eyebrow">Decor &amp; details</p>
            <h2>Make it yours.</h2>
          </div>

          <div class="addons-grid">
            <div class="addon-item">
              <span>Florals</span>
              <strong>from GHS 40</strong>
            </div>
            <div class="addon-item">
              <span>Faux balls</span>
              <strong>from GHS 50</strong>
            </div>
            <div class="addon-item">
              <span>Natural flowers</span>
              <strong>from GHS 200</strong>
            </div>
          </div>

          <p class="add-ons-note">
            Custom toppers, fondant details, edible images, gold leaf, moulded decorations and other specialty finishes are priced according to the design.
          </p>
        </div>
      </section>

      <section class="section-shell info-note-section">
        <div class="container">
          <div class="info-box">
            <h3>A little note about colour</h3>
            <p>
              Deep colours such as red, black, burgundy and dark blue require more food colouring and may have a slightly stronger aftertaste. Pastel shades are recommended where possible.
            </p>
          </div>
        </div>
      </section>

      <section id="order" class="section-shell order-section">
        <div class="container">
          <div class="section-heading center-aligned">
            <p class="eyebrow">Order</p>
            <h2>Ready to order?</h2>
          </div>

          <div class="order-grid">
            <article class="order-card">
              <div class="order-copy">
                <h3>Already know what you want?</h3>
                <p>Skip the form and send us your details directly on WhatsApp.</p>
              </div>
              <a href="#" class="btn btn-primary" data-whatsapp="true">ORDER ON WHATSAPP</a>
            </article>

            <article class="order-card alt-card">
              <div class="order-copy">
                <h3>Not sure what you need?</h3>
                <p>Tell us about your cake and we'll help you figure it out.</p>
              </div>
              <a href="https://tally.so/r/A7ON1N" class="btn btn-secondary" data-enquiry="true">START A CAKE ENQUIRY</a>
            </article>
          </div>
        </div>
      </section>

      <section class="section-shell before-section">
        <div class="container">
          <div class="section-heading left-aligned">
            <p class="eyebrow">Planning ahead</p>
            <h2>Before you order</h2>
          </div>

          <ul class="before-list">
            <li>Cakes should be booked at least 3 days in advance.</li>
            <li>Full payment is required to confirm your order.</li>
            <li>Custom designs may be priced differently from the starting prices shown.</li>
            <li>Delivery is available at an additional cost based on location.</li>
            <li>Cake availability is subject to the date requested.</li>
          </ul>
        </div>
      </section>
    </main>

    <footer id="contact" class="site-footer">
      <div class="container footer-wrap">
        <div>
          <p class="eyebrow">Let’s make your cake</p>
          <h2>Let's make your cake.</h2>
          <p class="footer-copy">Have something specific in mind?</p>
        </div>

        <div class="footer-actions">
          <a href="#" class="btn btn-primary" data-whatsapp="true">ORDER ON WHATSAPP</a>
          <a href="https://tally.so/r/A7ON1N" class="btn btn-secondary" data-enquiry="true">SEND AN ENQUIRY</a>
        </div>

        <div class="contact-details">
          <p><strong>Instagram:</strong> @its_eviebaker</p>
          <p><strong>WhatsApp:</strong> +233 243 366 083</p>
        </div>
      </div>
    </footer>

    <a
      class="mobile-whatsapp"
      href="#"
      aria-label="Chat on WhatsApp"
      data-whatsapp="true"
    >
      WhatsApp
    </a>

    <script src="script.js"></script>
  </body>
</html>
